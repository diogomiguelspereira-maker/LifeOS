# LifeOS environment template (committed reference — copy to `.env.local`
# and fill in your values; `.env.local` is git-ignored).

# --- Supabase: client + server ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- App URL (canonical production URL) ---
NEXT_PUBLIC_APP_URL=https://your-domain.example

# --- OpenAI (Nova assistant) ---
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Waze / road alerts ---
APIFY_ACTOR_ID=your-actor-id
APIFY_TOKEN=apify-your-token
SCRAPINGBEE_API_KEY=your-scrapingbee-key

# --- Google Calendar sync ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_TOKEN_KEY=your-token-encryption-key

# --- GoCardless (bank sync) ---
GOCARDLESS_SECRET_ID=your-secret-id
GOCARDLESS_SECRET_KEY=your-secret-key